# No API key is used. Continue with ChatGPT in the local app.
HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
# Set to the exact trusted HTTPS LAN origin for the phone pairing URL.
# PUBLIC_ORIGIN=https://192.168.1.50:3210
# TLS_CERT=./.certs/local.pem
# TLS_KEY=./.certs/local-key.pem
# Separate HTTP loopback callback; must use 127.0.0.1 and /auth/callback.
OAUTH_PORT=3211
# Optional; otherwise the first account-visible model is used.
# TUTOR_MODEL=
MAX_TURNS_PER_DAY=80
MAX_INPUT_CHARS=90000
# Optional scholarly metadata key, kept on the server.
# OPENALEX_API_KEY=
# Direct LAN WebRTC works without ICE servers. Optional JSON configuration:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
